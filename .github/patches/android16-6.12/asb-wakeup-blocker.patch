+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_ASB_WAKEUP_BLOCKER_H
+#define _LINUX_ASB_WAKEUP_BLOCKER_H
+
+#include <linux/types.h>
+
+#ifdef CONFIG_ASB_WAKEUP_BLOCKER
+bool asb_wakeup_source_blocked(const char *name);
+#else
+static inline bool asb_wakeup_source_blocked(const char *name)
+{
+	return false;
+}
+#endif
+
+#endif /* _LINUX_ASB_WAKEUP_BLOCKER_H */
